# 本地运行用：复制成 .env 后填写。GitHub 上运行时，这些值放在仓库的 Settings → Secrets 里
# 部署脚本 scripts/setup-github.mjs 每次都会把这里的 DEEPSEEK_API_KEY、SMTP_*、MAIL_TO、TIKHUB_API_KEY 加密同步到 Secrets
DEEPSEEK_API_KEY=
# 抖音高赞榜、小红书（TikHub 付费接口）
TIKHUB_API_KEY=
# 发信邮箱（默认 QQ 邮箱；用 163 就改 SMTP_HOST=smtp.163.com）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ号@qq.com
SMTP_PASS=QQ邮箱的SMTP授权码（不是QQ密码）
# 收件人，多个用英文逗号隔开。报警默认发给第一个；想单独指定，在 GitHub Secrets 里加 ALERT_TO（部署脚本不同步它）
MAIL_TO=a@qq.com,b@qq.com
# GitHub 授权码：部署用。细粒度授权码只选本仓库，需要 Contents、Secrets、Pages、Actions、Workflows 的读写权限
GITHUB_TOKEN=
# 只能触发 / 查看运行的授权码（立即推送.cmd 和 cron-job.org 用），见 README「长期授权码」
TRIGGER_TOKEN=
# 可选：cron-job.org 的 API Key，用接口管理准点触发任务时才需要
CRONJOB_API_KEY=
# 可选：网页地址，邮件里的「打开网页版」按钮用（GitHub 上运行时工作流会自动填）
SITE_URL=
